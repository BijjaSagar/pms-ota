# TriponX frontend — copy to .env.local if you need to change these.

# Where the app sends API calls. Leave as /api/v1 in development: Vite forwards /api to the backend
# (see vite.config.js), so the browser talks to one origin and the httpOnly sign-in cookies just work.
# In production, point it at the deployed API, e.g. https://api.triponx.com/api/v1
# (then add the site's origin to the backend's CORS_ORIGINS and set REFRESH_COOKIE_SAMESITE=none).
VITE_API_URL=/api/v1

# Dev only: the NestJS backend the Vite proxy forwards /api to.
VITE_API_PROXY_TARGET=http://localhost:3000
